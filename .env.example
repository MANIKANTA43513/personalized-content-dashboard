# --- Optional: real content APIs (server-side only, never exposed to the browser) ---
# Leave blank to run in MOCK MODE (realistic generated data, no network needed).
# https://newsapi.org/
NEWS_API_KEY=
# https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# --- Authentication ---
# Used to sign the httpOnly session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Optional tuning ---
# Polling interval for live feed updates, in milliseconds (default 30000)
NEXT_PUBLIC_LIVE_POLL_MS=30000
# Artificial latency (ms) for MOCK mode so loading skeletons are visible (default 250, max 5000)
MOCK_DELAY_MS=250
